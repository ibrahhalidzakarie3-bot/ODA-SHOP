<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ODA SHOP - Agadez</title>
<style>
body{font-family:Arial;background:#f5f5f5;margin:0;padding:10px}
h1{text-align:center;color:#0a7d2e}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px}
.card{background:white;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.15);padding-bottom:8px}
.card img{width:100%;height:180px;object-fit:cover;background:#eee}
.info{padding:8px}
.price{color:#e60000;font-weight:bold;font-size:18px}
.btn{display:block;background:#25D366;color:white;text-align:center;padding:10px;border-radius:8px;text-decoration:none;margin:8px;font-weight:bold}
#status{text-align:center;padding:15px;background:yellow;border-radius:8px;margin:10px}
</style>
</head>
<body>
<h1>ODA SHOP AGADEZ - NEUF</h1>
<div id="status">Chargement... Attends 5 sec ABEE</div>
<div class="grid" id="grid"></div>

<script>
const SHEET_ID = "1895VPzGc3iNWS7psJNQUNBP0MjVy_PvncEkapwnNbFQ";
const GID = "23900123";
const URL_CSV = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/export?format=csv&gid=${GID}`;

async function loadProduits(){
  try{
    const res = await fetch(URL_CSV);
    if(!res.ok) throw new Error("Pas publié");
    const text = await res.text();
    const lignes = text.split("\n");
    const headers = lignes[0].split(",").map(h=>h.trim().toLowerCase());
    
    let idxCode = headers.findIndex(h=>h.includes("code"));
    let idxApprouve = headers.findIndex(h=>h.includes("approuve"));
    let idxSerie = headers.findIndex(h=>h.includes("serie") || h.includes("prive"));
    
    // Si pas trouvé, on prend par position de ta photo
    if(idxCode<0) idxCode = 0;
    if(idxApprouve<0) idxApprouve = 2;

    const grid = document.getElementById("grid");
    grid.innerHTML = "";
    let count = 0;

    for(let i=1; i<lignes.length; i++){
      if(!lignes[i].trim()) continue;
      const cols = lignes[i].split(",");
      const code = cols[idxCode] ? cols[idxCode].replace(/"/g,"").trim() : "";
      const approuve = cols[idxApprouve] ? cols[idxApprouve].replace(/"/g,"").trim().toLowerCase() : "";

      if(approuve === "oui" || approuve === "oui" || approuve === "OUI" || approuve.includes("oui")){
        count++;
        grid.innerHTML += `
          <div class="card">
            <img src="https://via.placeholder.com/300x300?text=${code}" alt="${code}">
            <div class="info">
              <b>${code}</b><br>
              <small>Original Agadez - ${cols[idxSerie]||""}</small>
              <div class="price">Sur commande</div>
              <a class="btn" href="https://wa.me/227XXXXXXXX?text=Salam ABEE je veux ${code}">Commander WhatsApp</a>
            </div>
          </div>`;
      }
    }

    document.getElementById("status").innerHTML = count>0 
      ? `✅ ${count} produits approuvés - C'est bon ABEE !` 
      : `⚠️ Aucun produit avec OUI - Dans ton tableau mets OUI dans la colonne APPROUVE ?`;

  } catch(e){
    document.getElementById("status").innerHTML = `❌ Erreur encore: ${e.message}<br>Va dans Fichier > Partager > Publier sur le web > Publier`;
  }
}
loadProduits();
</script>
</body>
</html>
